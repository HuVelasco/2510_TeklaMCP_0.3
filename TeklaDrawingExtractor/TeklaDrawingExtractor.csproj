<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TeklaDrawingExtractor</AssemblyName>
    <RootNamespace>TeklaDrawingExtractor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- System References -->
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />

    <!-- Tekla API References -->
    <Reference Include="Tekla.Structures">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.dll</HintPath>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.Model.dll</HintPath>
    </Reference>
    <Reference Include="Tekla.Structures.Geometry3d">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.Geometry3d.Compatibility.dll</HintPath>
    </Reference>
    <Reference Include="Tekla.Structures.Drawing">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.Drawing.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet Packages -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
