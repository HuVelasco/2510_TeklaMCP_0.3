<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <StartupObject>TeklaMCP.ProgramUltraSimple</StartupObject>
    <DefineConstants Condition="Exists('C:\TeklaStructures\2024.0\bin\Tekla.Structures.Model.dll')">TEKLA_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Only include Tekla references if assemblies exist -->
  <ItemGroup Condition="Exists('C:\TeklaStructures\2024.0\bin\Tekla.Structures.Model.dll')">
    <Reference Include="Tekla.Structures">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.dll</HintPath>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.Model.dll</HintPath>
    </Reference>
    <Reference Include="Tekla.Structures.Geometry3d">
      <HintPath>C:\TeklaStructures\2024.0\bin\Tekla.Structures.Geometry3d.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude all the complex V1 architecture -->
    <Compile Remove="Program.cs" />
    <Compile Remove="ProgramSimple.cs" />
    <Compile Remove="Core\**" />
    <Compile Remove="Endpoints\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Utils\**" />
    <Compile Remove="Services\**" />
  </ItemGroup>

</Project>